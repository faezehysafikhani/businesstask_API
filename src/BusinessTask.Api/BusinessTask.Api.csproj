<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>BusinessTask.Api</RootNamespace>
    <AssemblyName>BusinessTask.Api</AssemblyName>
  </PropertyGroup>

  <!-- The host owns no domain logic: it only composes NexusCore packages (see docs/ARCHITECTURE.md). -->
  <ItemGroup>
    <PackageReference Include="Nexus.Bundles.Platform" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.TaskManagement" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.TaskManagement.Infrastructure" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Integrations.TaskNotifications" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Integrations.TaskReporting" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Calendar.Infrastructure" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Integrations.CalendarTasks" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Integrations.CalendarOrgStructure" Version="$(NexusCoreVersion)" />
    <!-- Projects (phase 11): the charter, its team, its stakeholders, and the portfolio view. -->
    <PackageReference Include="Nexus.ProjectManagement.Core" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.ProjectManagement.Core.Infrastructure" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.ProjectManagement.Team" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.ProjectManagement.Team.Infrastructure" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.ProjectManagement.Stakeholder" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.ProjectManagement.Stakeholder.Infrastructure" Version="$(NexusCoreVersion)" />
    <!-- Portfolio combines projects and actions, so the action module comes with it. -->
    <PackageReference Include="Nexus.Actions" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Actions.Infrastructure" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Portfolio" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Integrations.ProjectVisibility" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Nexus.Integrations.ProjectDeletion" Version="$(NexusCoreVersion)" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BusinessTask.Tests" />
  </ItemGroup>

</Project>
