<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Closed-network rule: restore only from the offline feed. Build it once with eng/make-offline-feed.sh.
       Core packages come from the Core repo (branch feature/1405-08-19-UxChanges) via `dotnet pack`. -->
  <packageSources>
    <clear />
    <add key="offline-feed" value="packages" />
  </packageSources>
</configuration>
