<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- One place to move every NexusCore package at once. -->
    <NexusCoreVersion>0.1.0.1405082002-ux</NexusCoreVersion>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
